# ============================================================================
# BizPilot Backend — Environment Variables Template
# ============================================================================
# Copy this file to .env.local to configure your local development environment.
# Never commit real credentials or .env.local to version control.
# ============================================================================

PORT=4000
NODE_ENV=development

# Allowed Frontend Origins (Comma-separated for CORS)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------------------------
# 1. POSTGRESQL HOSTED DATABASE (Server-Side Only via pg.Pool)
# ----------------------------------------------------------------------------
# Direct connection (Port 5432) or Connection Pooler (Port 6543):
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# ----------------------------------------------------------------------------
# 2. APPLICATION AUTHENTICATION & SESSION SECURITY (Server-Side Only)
# ----------------------------------------------------------------------------
# Secret key used to sign secure HTTP-only session tokens.
# Generate a random 32-character string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=your-random-32-character-session-secret-here

# ----------------------------------------------------------------------------
# 3. DEMO MODE TOGGLE
# ----------------------------------------------------------------------------
# Set to 'false' to enable live database persistence once DATABASE_URL is set.
# Set to 'true' to force local offline demonstration mode.
NEXT_PUBLIC_DEMO_MODE=false
